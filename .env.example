# Copy this file to .env and fill it in (README, steps 2-4). Never commit .env.

# Claude: writes topics, sticker concepts and captions. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Higgsfield API: sticker images and videos (pay as you go). https://open.higgsfield.ai
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Instagram API with Instagram Login: token from your Meta app (README, step 2)
IG_ACCESS_TOKEN=

# Public GitHub repository that serves the media to Instagram (set automatically by scripts/deploy.ps1)
MEDIA_REPO=

# Created by `python run.py seal-token` (encrypts the Instagram token for GitHub Actions)
TOKEN_KEY=
